# AEGIS — AI Emergency Information & Alert Assurance System
# Environment Configuration Template

# Gemini AI API Key (Required for server-side Gemini AI. Injected automatically by AI Studio)
GEMINI_API_KEY=

# Server Port (Default: 3000)
PORT=3000

# Application Base URL
APP_URL="http://localhost:3000"

# External Data & Provider Configurations (Integration Ready)
# Note: If unset, AEGIS will run in verified DEMO/NOT CONFIGURED mode without failing.
DATABASE_URL="file:./aegis.db"
WEATHER_API_KEY=""
SEISMIC_API_KEY=""
MAPS_API_KEY=""
SMS_API_KEY=""
SMS_PROVIDER="demo_sandbox"
PUSH_PROVIDER="w3c_vapid"
CELL_BROADCAST_PROVIDER="not_configured"
